# Base URL of the Fit for Surgery REST API.
# Default "/api/v1" = same origin: the Vite dev server proxies it (see VITE_PROXY_TARGET),
# and in production your web server/CDN should route /api to the backend.
# If you point this at another host, it must be same-site with the frontend
# (e.g. app.example.com + api.example.com) or the backend's SameSite=strict auth cookie won't be sent.
VITE_API_BASE_URL=/api/v1

# Dev only: where the Vite dev server proxies /api requests.
VITE_PROXY_TARGET=http://localhost:5000

# Dev/demo only: serve all API calls from the in-browser mock (src/mocks) so the frontend
# runs without the backend. Seeded logins use the password "Password123!".
# Production builds force this off (.env.production).
VITE_USE_MOCK=false

# Minutes of inactivity before automatic sign-out (a 60s warning is shown first). Default 15.
VITE_IDLE_TIMEOUT_MINUTES=15

# Optional error reporting. When empty, the Sentry SDK is not bundled at all.
# Reports are scrubbed of request bodies, form input and record ids (see src/lib/monitoring.ts).
VITE_SENTRY_DSN=
