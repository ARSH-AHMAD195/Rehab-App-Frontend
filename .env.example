# The three live APIs (Render). Every path starts with /api/v1.
VITE_AUTH_API_URL=https://ffs-auth-api.onrender.com/api/v1
VITE_HEALTH_API_URL=https://ffs-health-monitoring-api.onrender.com/api/v1
VITE_EXERCISE_API_URL=https://ffs-exercise-api.onrender.com/api/v1

# Firebase web app config for the rehab-app-development project (Project settings > General > Your apps).
# These identify the project; they are not secrets, but never put passwords or server keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rehab-app-development.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rehab-app-development
VITE_FIREBASE_APP_ID=

# Minutes of inactivity before automatic sign-out (a 60s warning is shown first). Default 15.
VITE_IDLE_TIMEOUT_MINUTES=15

# Optional error reporting. When empty, the Sentry SDK is not bundled at all.
VITE_SENTRY_DSN=
